# Copy this file to `.env` and fill in real values.
# `.env` itself is gitignored — never commit real keys.

# GEMINI setup (this project is currently using Gemini 3.5 Flash as both
# primary and fallback model — see PRIMARY_MODEL/FALLBACK_MODEL below).
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Not needed for the Gemini setup below, but config.py still reads these
# if you ever switch PRIMARY_MODEL/FALLBACK_MODEL back to a Groq or OpenAI name.
GROQ_API_KEY=
OPENAI_API_KEY=

# ---- Active model config (Gemini) ----
# "gemini" in the model name auto-routes through llm_engine._call_gemini()
# instead of Groq -- no code changes needed, this is the only switch.
# (FALLBACK_PROVIDER is irrelevant here: _call_model() checks for "gemini"
# in the model name before it ever looks at FALLBACK_PROVIDER, so leaving
# it unset/at its "groq" default is fine and has no effect.)
PRIMARY_MODEL=gemini-3.5-flash
FALLBACK_MODEL=gemini-3.5-flash

# ---- Other optional overrides (defaults shown in config.py) ----
# LLM_TEMPERATURE=0.0
# MAX_TOKENS=2048
# REASONING_EFFORT=low
# REASONING_FORMAT=hidden
# ROUTER_LEN_THRESHOLD_1=300
# ROUTER_LEN_THRESHOLD_2=500
# ROUTER_COMPLEXITY_THRESHOLD=3
# REQUEST_TIMEOUT_SECONDS=15.0
# MAX_RETRIES=1
# SINGLE_SIGNAL_FLOOR_FACTOR=0.5
# HIGH_RISK_THRESHOLD=0.7
# MODERATE_RISK_THRESHOLD=0.4
# LOG_LEVEL=INFO

