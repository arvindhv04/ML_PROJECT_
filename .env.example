# Copy this file to `.env` and fill in real values.
# `.env` itself is gitignored — never commit real keys.

# Required — powers both the primary and fallback models on Groq's free tier.
GROQ_API_KEY=

# Optional — only needed if FALLBACK_PROVIDER=openai
OPENAI_API_KEY=

# Optional — only needed if PRIMARY_MODEL / FALLBACK_MODEL is a gemini-* model.
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional overrides (defaults shown in config.py) ----
# PRIMARY_MODEL=openai/gpt-oss-20b
# FALLBACK_MODEL=openai/gpt-oss-120b
# FALLBACK_PROVIDER=groq
# LLM_TEMPERATURE=0.0
# MAX_TOKENS=2048
# REASONING_EFFORT=low
# REASONING_FORMAT=hidden
# ROUTER_LEN_THRESHOLD_1=300
# ROUTER_LEN_THRESHOLD_2=500
# ROUTER_COMPLEXITY_THRESHOLD=3
# REQUEST_TIMEOUT_SECONDS=15.0
# MAX_RETRIES=1
# SINGLE_SIGNAL_FLOOR_FACTOR=0.5
# HIGH_RISK_THRESHOLD=0.7
# MODERATE_RISK_THRESHOLD=0.4
# LOG_LEVEL=INFO
